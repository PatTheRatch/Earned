# Swift / SwiftPM
.build/
.swiftpm/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/

# macOS
.DS_Store

# Supabase local dev
backend/.branches/
backend/.temp/

# Generated by XcodeGen from app/project.yml. The entitlements next to these
# are *not* generated and must stay checked in — see the comments in
# project.yml for what happens when XcodeGen writes them instead.
app/*.xcodeproj
app/Earned/Info.plist
app/EarnedMonitor/Info.plist

# The backend project this build talks to. Not checked in: the anon key is
# public by design, but the project URL is not, and a forked repo pointing at
# someone else's Supabase is a bad default. See backend/README.md.
app/Earned/Backend.plist

# Private keys, never. The root key belongs outside this repository entirely
# (docs/deployment.md §5.3) — this is the net under that, not the plan.
*.pem
*.key
