<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.family-controls</key>
	<true/>
	<!-- Sign in with Apple. Needed before a Contract Envelope can exist, because
	     an envelope hangs off an account. Adding this entitlement means the App
	     ID needs the matching capability enabled in Xcode's Signing &
	     Capabilities, exactly as Family Controls did — until then a device
	     build fails to sign. See app/README.md. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- HealthKit, read-only in practice: the importer asks for workouts and
	     nothing else, and never writes. Same capability caveat as the others —
	     the App ID needs HealthKit enabled under Signing & Capabilities or a
	     device build fails to sign. -->
	<key>com.apple.developer.healthkit</key>
	<true/>
</dict>
</plist>
